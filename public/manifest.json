{
  "manifest_version": 3,
  "name": "Adobe Stock AI Metadata Assistant",
  "version": "1.0.0",
  "description": "AI-powered metadata optimization for stock creators",
  "action": {
    "default_popup": "index.html",
    "default_title": "Adobe Stock AI Metadata Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}
